const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');
const {overlayEngine} = require('../runtime/overlay.cts');
function build(input, destination) {
  const engine=overlayEngine(),c=engine.normalize(input),v=engine.view(c);
  const json=JSON.stringify(c).replace(/</g,'\\u003c');
  const script=`const engine=(${overlayEngine.toString()})();let config=${json};const canvas=document.getElementById('canvas');function fit(){canvas.style.transform='translate(-50%,-50%) scale('+Math.min(innerWidth/config.width,innerHeight/config.height)+')'}window.addEventListener('resize',fit);window.StreamOverlay=Object.freeze({update(patch){if(!patch||typeof patch!=='object'||Array.isArray(patch))throw Error('Invalid patch');for(const k of Reflect.ownKeys(patch))if(!Object.hasOwn({title:1,copy:1,accent:1,background:1,foreground:1,schedule:1},k))throw Error('Unsupported live field');const next=engine.normalize({...config,...patch});const view=engine.view(next);document.getElementById('overlay-style').textContent=view.css;canvas.innerHTML=view.html;config=next;fit();return engine.geometry(config)},geometry(){return engine.geometry(config)}});fit();`;
  const html=`<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Stream overlay</title><style id="overlay-style">${v.css}</style></head><body><main id="canvas" data-od-id="overlay-canvas" aria-label="Stream overlay">${v.html}</main><script>${script}</script></body></html>`;
  // Exclusive output directories preserve all approved and interrupted builds.
  fs.mkdirSync(destination,{recursive:false});
  fs.writeFileSync(path.join(destination,'index.html'),html);
  fs.writeFileSync(path.join(destination,'source.json'),JSON.stringify(c,null,2));
  fs.cpSync(path.resolve(__dirname,'..','runtime'),path.join(destination,'editable','runtime'),{recursive:true});
  fs.cpSync(__filename,path.join(destination,'editable','tools','build.cts'),{recursive:false});
  const report={plugin:'stream-overlay-authoring',version:'0.1.0',variant:c.variant,motion:'static',geometry:engine.geometry(c),provenance:{geometry:'Calculated source-pixel layout bounds from original CSS; not pixel-measured evidence',fonts:c.font?{source:c.font.source,license:c.font.license,scope:'this output only'}:'System fonts; no font assets',brand:'Input colors/title are user values or explicitly chosen defaults; no measured brand source implied',schedule:c.synthetic?'Synthetic demonstration content':'Creator supplied; verify accuracy'},sha256:crypto.createHash('sha256').update(html).digest('hex')};
  fs.writeFileSync(path.join(destination,'manifest.json'),JSON.stringify(report,null,2));
  fs.writeFileSync(path.join(destination,'README.md'),`# OBS overlay\n\nAdd Browser Source → Local file → index.html. Set width ${c.width}, height ${c.height}. Keep OBS default transparent browser-source CSS. Place camera-frame ABOVE your camera source; align camera to aperture in manifest.json. Schedule fills the canvas. No authentication, internet, audio, flags or external assets required. Both motion choices are static; reduced motion is inherently respected. No GSAP or timeline is used because no animation is authored.\n\nEdit source.json, then run Node 24: node editable/tools/build.cts source.json ../overlay-v2. Destination must be new. Retain this version until the replacement is approved. Geometry is calculated from CSS layout in source pixels, not pixel-measured evidence; OBS scaling scales the whole composition.\n\nBrowser API: StreamOverlay.update({title,copy,accent,background,foreground,schedule}) accepts any subset, validates atomically, and returns geometry. Text is escaped; colors are #RRGGBB with contrast checks. StreamOverlay.geometry() reports calculated variant-specific bounds: camera clear aperture and external border/nameplate with partial canvas coverage, or schedule full opaque canvas coverage and schedule/row bounds with no camera fields. Blank/auto/null or omitted aperture derives from dimensions for camera; explicit object or JSON uses source pixels. Schedule ignores aperture entirely. Live updates are ephemeral; edit source.json and rebuild to persist.\n\nsource.json embeds any supplied font; retain its license and do not redistribute without permission. manifest.json records provenance and output hash.\n`);
  return {html,report,config:c};
}
if(require.main===module){if(process.argv.length!==4) throw Error('Usage: node tools/build.cts config.json new-output-folder');build(JSON.parse(fs.readFileSync(process.argv[2],'utf8')),path.resolve(process.argv[3]));}
module.exports={build};
