const {test}=require('node:test');const assert=require('node:assert/strict');
const {validate,createAdapter}=require('../src/adapter.cts');
const payload=(id,displayName='Sample follower')=>({type:'follow',displayName,...(id===undefined?{}:{id})});
async function fixture(){const starts=[],callbacks=[];let stops=0,idles=0;const api=createAdapter({start(p,done){starts.push(p);callbacks.push(done);},stop(){stops++;},idle(){idles++;}});await Promise.resolve();return {api,starts,callbacks,get stops(){return stops},get idles(){return idles}};}
test('payload type, empty/whitespace, bounds and optional id validation',()=>{
 for(const p of [null,{},[],payload(1),payload('x',''),payload('x',' \n '),payload('x','a'.repeat(65)),payload('x'.repeat(129)),{type:'raid',displayName:'A'},{type:'follow',displayName:42}])assert.equal(validate(p),null);
 assert.ok(validate(payload(undefined,'é'.repeat(64))));assert.ok(validate(payload('', '👻'.repeat(64))));assert.equal(validate(payload('id','👻'.repeat(65))),null);assert.ok(validate(payload('x'.repeat(128))));
 assert.ok(validate(payload('id','A\u0301'.repeat(32))));assert.equal(validate(payload('id','A\u0301'.repeat(33))),null);
});
test('payload snapshot is immutable and HTML-like name is preserved as data',async()=>{const f=await fixture();const p=payload('id','<img src=x onerror=alert(1)>');f.api.play(p);p.displayName='changed';assert.equal(f.starts[0].displayName,'<img src=x onerror=alert(1)>');assert.ok(Object.isFrozen(f.starts[0]));const state=f.api.getState();state.current.displayName='changed';assert.notEqual(f.api.getState().current.displayName,'changed');});
test('idle default and empty replay status',async()=>{const f=await fixture();assert.equal(f.api.getState().state,'idle');assert.equal(f.starts.length,0);assert.equal(f.api.replay().status,'invalid');});
test('strict FIFO, 20 waiting capacity and explicit full status',async()=>{const f=await fixture();assert.equal(f.api.play(payload('active')).status,'accepted');for(let i=0;i<20;i++)assert.equal(f.api.play(payload('q'+i)).status,'accepted');assert.equal(f.api.getState().queued,20);assert.equal(f.api.play(payload('overflow')).status,'queue-full');for(let i=0;i<21;i++){assert.equal(f.starts[i].id,i===0?'active':'q'+(i-1));f.callbacks[i]();}assert.equal(f.api.getState().state,'idle');assert.equal(f.api.getState().queued,0);assert.equal(f.api.play(payload('overflow')).status,'accepted');});
test('IDs deduplicate accepted events and replay intentionally bypasses dedupe',async()=>{const f=await fixture();f.api.play(payload('same'));assert.equal(f.api.play(payload('same')).status,'duplicate');assert.equal(f.api.replay().status,'accepted');f.callbacks[0]();assert.equal(f.starts[1].id,'same');f.callbacks[1]();assert.equal(f.api.replay().status,'accepted');});
test('last 100 accepted IDs evict oldest; rejected events do not enter history',async()=>{const f=await fixture();for(let i=0;i<101;i++){f.api.play(payload('id'+i));f.callbacks[i]();}assert.equal(f.api.getState().rememberedIds,100);assert.equal(f.api.play(payload('id1')).status,'duplicate');assert.equal(f.api.play(payload('id0')).status,'accepted');assert.equal(f.api.play(payload('invalid','')).status,'invalid');assert.equal(f.api.play(payload('invalid')).status,'accepted');});
test('events without IDs can repeat',async()=>{const f=await fixture();assert.equal(f.api.play(payload()).status,'accepted');assert.equal(f.api.play(payload()).status,'accepted');});
test('cancel stops current, clears queue, ignores stale completion and remains ready',async()=>{const f=await fixture();f.api.play(payload('one'));f.api.play(payload('two'));const stale=f.callbacks[0];assert.equal(f.api.cancel().status,'cancelled');assert.equal(f.stops,1);assert.equal(f.idles,1);assert.equal(f.api.getState().state,'idle');assert.equal(f.api.getState().queued,0);assert.equal(f.api.play(payload('three')).status,'accepted');stale();assert.equal(f.api.getState().current.id,'three');f.callbacks[1]();assert.equal(f.api.getState().state,'idle');assert.equal(f.api.play(payload('one')).status,'duplicate');assert.equal(f.api.replay().status,'accepted');});
test('font readiness gates playback and cancel while loading clears pending work',async()=>{let resolve;const ready=new Promise(r=>resolve=r);const starts=[];const api=createAdapter({start:p=>starts.push(p),stop(){},idle(){}},ready);assert.equal(api.getState().state,'loading');for(let i=0;i<20;i++)assert.equal(api.play(payload(String(i))).status,'accepted');assert.equal(api.play(payload('full')).status,'queue-full');assert.equal(starts.length,0);api.cancel();resolve();await ready;assert.equal(api.getState().state,'idle');assert.equal(starts.length,0);assert.equal(api.play(payload('fresh')).status,'accepted');assert.equal(starts.length,1);});
