const {test}=require('node:test'),assert=require('node:assert/strict'),fs=require('node:fs'),vm=require('node:vm'),path=require('node:path');
async function fixture(preview){let resolve;const ready=new Promise(r=>resolve=r);const nodes={};for(const id of ['brand','event','headline','footer','card','stage','name','preview','result','replay','cancel'])nodes[id]={style:{},hidden:true,clientHeight:90,clientWidth:500,scrollHeight:50,scrollWidth:200};nodes.config={textContent:JSON.stringify({width:960,height:320,duration:6,sampleFollower:'Écho 👻'})};let starts=0,done,idle=0;const window={};const ctx=vm.createContext({window,document:{getElementById:id=>nodes[id],fonts:{ready}},matchMedia:()=>({matches:false}),innerWidth:480,innerHeight:320,addEventListener(){},URLSearchParams,location:{search:preview?'?preview=1':''},Promise,AlertComposition:{createComposition(){return {start(fn){starts++;done=fn;},pause(){},idle(){idle++;}}}}});
 vm.runInContext(fs.readFileSync(path.join(__dirname,'../src/adapter.cts'),'utf8'),ctx);ctx.AlertAdapter=window.AlertAdapter;
 // Browser globals map window properties to global bindings.
 Object.defineProperty(ctx,'StreamAlert',{get:()=>window.StreamAlert});
 vm.runInContext(fs.readFileSync(path.join(__dirname,'../src/live.cts'),'utf8'),ctx);
 return {nodes,window,resolve,finish:()=>done(),get starts(){return starts},get idle(){return idle}};
}
test('normal output waits for fonts, stays idle, accepts safe text and finishes',async()=>{const f=await fixture(false);f.resolve();await new Promise(setImmediate);assert.equal(f.starts,0);assert.equal(f.nodes.preview.hidden,true);assert.equal(f.nodes.stage.style.transform,'scale(0.5)');const payload={type:'follow',displayName:'<img src=x>'};f.window.StreamAlert.play(payload);assert.equal(f.nodes.name.textContent,payload.displayName);f.finish();assert.equal(f.window.StreamAlert.getState().state,'idle');assert.equal(f.idle,1);});
test('explicit preview emits once; replay and cancel are wired',async()=>{const f=await fixture(true);assert.equal(f.starts,0);f.resolve();await new Promise(setImmediate);assert.equal(f.starts,1);assert.equal(f.nodes.preview.hidden,false);assert.equal(f.nodes.name.textContent,'Écho 👻');f.finish();assert.equal(f.starts,1);f.nodes.replay.onclick();assert.equal(f.starts,2);f.nodes.cancel.onclick();assert.equal(f.window.StreamAlert.getState().state,'idle');});
